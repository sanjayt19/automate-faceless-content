{
 "genre": "education",
 "animation_mode": "scene_based",
 "title": "The Message That Actually Gets Answered",
 "book": "The 2-Hour Job Search",
 "author": "Steve Dalton",
 "accent": "burnt orange",
 "sources": [
  "https://www.axios.com/2026/08/21/job-seekers-ai-hiring-ghost-jobs-trust",
